region      = "us-east-2"
environment = "dev"
github_repo = "your-github-username/encoder-gpt"
alarm_email = ""

# "basic" runs on the AWS Free plan. Switch to "comprehend" on a Paid plan.
redaction_mode = "basic"

# Persistent OpenClaw agent that operates the service. Always-on: stop it
# (or set false and apply) when you're not demoing to save credits.
enable_fleet_agent = false
